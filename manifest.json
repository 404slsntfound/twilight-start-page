{
  "manifest_version": 3,
  "name": "暮光起始页",
  "version": "1.6.0",
  "description": "Safari 风格的新标签页，支持收藏分组、最近打开、网站图标与玻璃拟态壁纸库。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "history"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
